<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="agaleasExamen.AcercaDe"
             Title="Acerca de">

    <VerticalStackLayout Spacing="12" Padding="20" HorizontalOptions="Center">

        <Image Source="yo.png"
               HeightRequest="140"
               HorizontalOptions="Center" />

        <Label Text="INFORMACIÓN DEL ESTUDIANTE"
               FontSize="22"
               FontAttributes="Bold"
               TextColor="Purple"
               HorizontalOptions="Center" />

        <Label Text="Estudiante: A. Galeas" FontSize="16" HorizontalOptions="Center" />
        <Label Text="Carrera: Ingeniería Informática" FontSize="16" HorizontalOptions="Center" />
        <Label Text="Paralelo: A" FontSize="16" HorizontalOptions="Center" />

        <Button Text="Volver"
                Style="{StaticResource EstiloBotonGlobal}"
                Clicked="OnVolverClicked" />

    </VerticalStackLayout>
</ContentPage>